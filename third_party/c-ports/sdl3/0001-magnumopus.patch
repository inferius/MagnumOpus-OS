diff --git a/CMakeLists.txt b/CMakeLists.txt
index f7c1528..8042840 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2110,8 +2110,10 @@ elseif(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU)
     endif()
   endif()
 
-  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/misc/unix/*.c")
-  set(HAVE_SDL_MISC TRUE)
+  if(NOT MAGNUMOPUS)
+    sdl_glob_sources("${SDL3_SOURCE_DIR}/src/misc/unix/*.c")
+    set(HAVE_SDL_MISC TRUE)
+  endif()
 
   if(SDL_POWER)
     if(LINUX)
@@ -3536,6 +3538,24 @@ endif()
 
 # Platform-independent options
 
+# MagnumOpus: okno kompozitoru pres libs/mosdl (modul platformy z xtasku
+# nastavi MAGNUMOPUS).
+if(SDL_AUDIO AND MAGNUMOPUS)
+  set(SDL_AUDIO_DRIVER_MAGNUMOPUS 1)
+  sdl_glob_sources(
+    "${SDL3_SOURCE_DIR}/src/audio/magnumopus/*.c"
+  )
+  set(HAVE_SDL_AUDIO TRUE)
+endif()
+
+if(SDL_VIDEO AND MAGNUMOPUS)
+  set(SDL_VIDEO_DRIVER_MAGNUMOPUS 1)
+  sdl_glob_sources(
+    "${SDL3_SOURCE_DIR}/src/video/magnumopus/*.c"
+  )
+  set(HAVE_SDL_VIDEO TRUE)
+endif()
+
 if(SDL_VIDEO)
   if(SDL_OFFSCREEN)
     set(SDL_VIDEO_DRIVER_OFFSCREEN 1)
diff --git a/include/SDL3/SDL_platform_defines.h b/include/SDL3/SDL_platform_defines.h
index 7963149..de6abaa 100644
--- a/include/SDL3/SDL_platform_defines.h
+++ b/include/SDL3/SDL_platform_defines.h
@@ -38,6 +38,19 @@
 #define SDL_PLATFORM_AIX 1
 #endif
 
+#ifdef __magnumopus__
+
+/**
+ * A preprocessor macro that is only defined if compiling for MagnumOpus.
+ *
+ * \since This macro is available since SDL 3.4.20 (MagnumOpus port).
+ */
+#define SDL_PLATFORM_MAGNUMOPUS 1
+/* System POSIX (cstd): unixove cesty SDL (vlakna pthread, cas, soubory).
+   Jen makro SDL, ne __unix__ (to by se dostalo i do aplikaci). */
+#define SDL_PLATFORM_UNIX 1
+#endif
+
 #ifdef __HAIKU__
 
 /**
