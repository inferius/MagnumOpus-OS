diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -81,6 +81,25 @@
 #include "unix_private.h"
 #ifdef __magnumopus__
 #include <magnumopus/process.h>
+
+/* Posle fd serveru pod pevnym cislem `num` (server ho vyzvedne jako
+ * inflight fd s timto cislem) a zavre ho. */
+static void mo_send_fd( int fd, int num )
+{
+    if (fd == -1) return;
+    if (fd != num)
+    {
+        if (dup2( fd, num ) != -1)
+        {
+            wine_server_send_fd( num );
+            close( num );
+        }
+        close( fd );
+        return;
+    }
+    wine_server_send_fd( fd );
+    close( fd );
+}
 #endif
 #include "ddk/wdm.h"
 
