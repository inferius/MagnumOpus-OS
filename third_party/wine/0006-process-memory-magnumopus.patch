diff --git a/server/ptrace.c b/server/ptrace.c
--- a/server/ptrace.c
+++ b/server/ptrace.c
@@ -471,9 +471,35 @@
     return !len;
 }
 
+#ifdef __magnumopus__
+#include <magnumopus/process.h>
+
+/* MagnumOpus: pamet klienta pres jeho procesovy fd (PROCESS_MEMORY v jadre,
+ * klient ho serveru sveril pri pripojeni); ptrace ani /proc neni. */
+static int mo_process_access( struct process *process, int op, client_ptr_t ptr, data_size_t size,
+                              char *buf, data_size_t *done )
+{
+    ssize_t len;
+
+    if (process->mem_fd == -1 || !is_process_init_done( process ) || (unsigned long)ptr != ptr)
+    {
+        set_error( STATUS_ACCESS_DENIED );
+        return 0;
+    }
+    len = mo_process_memory( process->mem_fd, op, ptr, buf, size );
+    if (done) *done = max( len, 0 );
+    if (len == size) return 1;
+    set_error( len >= 0 ? STATUS_PARTIAL_COPY : STATUS_ACCESS_DENIED );
+    return 0;
+}
+#endif
+
 /* read data from a process memory space */
 int read_process_memory( struct process *process, client_ptr_t ptr, data_size_t size, char *dest )
 {
+#ifdef __magnumopus__
+    return mo_process_access( process, MO_PROCESS_READ, ptr, size, dest, NULL );
+#else
     struct thread *thread = get_ptrace_thread( process );
     int ret;
 
@@ -487,6 +513,7 @@
 
     if ((ret = read_process_memory_vm( thread, ptr, size, dest )) != -1) return ret;
     return read_process_memory_ptrace( thread, ptr, size, dest );
+#endif
 }
 
 /* make sure we can write to the whole address range */
@@ -589,6 +616,9 @@
 int write_process_memory( struct process *process, client_ptr_t ptr, data_size_t size, const char *src,
                           data_size_t *written )
 {
+#ifdef __magnumopus__
+    return mo_process_access( process, MO_PROCESS_WRITE, ptr, size, (char *)src, written );
+#else
     struct thread *thread = get_ptrace_thread( process );
     int ret;
 
@@ -602,6 +632,7 @@
 
     if ((ret = write_process_memory_vm( thread, ptr, size, src, written )) != -1) return ret;
     return write_process_memory_ptrace( thread, ptr, size, src, written );
+#endif
 }
 
 
