+extern char **environ;
+#endif
 #ifdef HAVE_MACH_MACH_H
 # include <mach/mach.h>
 #endif
@@ -397,6 +401,90 @@
 }
 
 
+#ifdef __magnumopus__
+/***********************************************************************
+ *           spawn_process
+ *
+ * MagnumOpus: fork neni. Novy proces = posix_spawn zavadece Wine se
+ * stejnym prostredim, jake by mu dal exec_wineloader (WINESERVERSOCKET,
+ * WINELOADERNOEXEC), stdin/stdout pres akce souboru a pracovni adresar
+ * pres fchdir. Konec spojeni se serverem (socketfd) je bez FD_CLOEXEC
+ * a potomek ho zdedi.
+ */
+static NTSTATUS spawn_process( const RTL_USER_PROCESS_PARAMETERS *params, int socketfd,
+                               int unixdir, char *winedebug, const struct pe_image_info *pe_info )
+{
+    static char noexec[] = "WINELOADERNOEXEC=1";
+    NTSTATUS status = STATUS_SUCCESS;
+    int stdin_fd = -1, stdout_fd = -1, null_fd = -1, in_fd, out_fd, err;
+    posix_spawn_file_actions_t actions;
+    char socket_env[64], **argv, **envp;
+    size_t count = 0, i, k = 0;
+    BOOL detach;
+    pid_t pid;
+
+    if (wine_server_handle_to_fd( params->hStdInput, FILE_READ_DATA, &stdin_fd, NULL ) &&
+        isatty(0) && is_unix_console_handle( params->hStdInput ))
+        stdin_fd = 0;
+
+    if (wine_server_handle_to_fd( params->hStdOutput, FILE_WRITE_DATA, &stdout_fd, NULL ) &&
+        isatty(1) && is_unix_console_handle( params->hStdOutput ))
+        stdout_fd = 1;
+
+    detach = (peb->ProcessParameters && params->ProcessGroupId != peb->ProcessParameters->ProcessGroupId) ||
+             params->ConsoleHandle == CONSOLE_HANDLE_ALLOC ||
+             params->ConsoleHandle == CONSOLE_HANDLE_ALLOC_NO_WINDOW ||
+             params->ConsoleHandle == NULL;
+    in_fd = detach ? -1 : stdin_fd;
+    out_fd = detach ? -1 : stdout_fd;
+    if (in_fd == -1 || out_fd == -1) null_fd = open( "/dev/null", O_RDWR );
+    if (in_fd == -1) in_fd = null_fd;
+    if (out_fd == -1) out_fd = null_fd;
+
+    posix_spawn_file_actions_init( &actions );
+    if (in_fd != -1 && in_fd != 0) posix_spawn_file_actions_adddup2( &actions, in_fd, 0 );
+    if (out_fd != -1 && out_fd != 1) posix_spawn_file_actions_adddup2( &actions, out_fd, 1 );
+    if (unixdir != -1) posix_spawn_file_actions_addfchdir_np( &actions, unixdir );
+
+    snprintf( socket_env, sizeof(socket_env), "WINESERVERSOCKET=%u", socketfd );
+    while (environ[count]) count++;
+    envp = malloc( (count + 4) * sizeof(*envp) );
+    argv = build_argv( &params->CommandLine, 2 );
+    if (!envp || !argv)
+    {
+        status = STATUS_NO_MEMORY;
+        goto done;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (!strncmp( environ[i], "WINESERVERSOCKET=", 17 )) continue;
+        if (!strncmp( environ[i], "WINELOADERNOEXEC=", 17 )) continue;
+        if (winedebug && !strncmp( environ[i], "WINEDEBUG=", 10 )) continue;
+        envp[k++] = environ[i];
+    }
+    envp[k++] = socket_env;
+    envp[k++] = noexec;
+    if (winedebug) envp[k++] = winedebug;
+    envp[k] = NULL;
+
+    argv[1] = (char *)wineloader;
+    err = posix_spawn( &pid, wineloader, &actions, NULL, argv + 1, envp );
+    if (err)
+    {
+        ERR( "posix_spawn %s: %s\n", wineloader, strerror( err ));
+        status = err == ENOENT ? STATUS_OBJECT_NAME_NOT_FOUND : STATUS_NO_MEMORY;
+    }
+
+done:
+    posix_spawn_file_actions_destroy( &actions );
+    free( envp );
+    free( argv );
+    if (null_fd != -1) close( null_fd );
+    if (stdin_fd != -1 && stdin_fd != 0) close( stdin_fd );
+    if (stdout_fd != -1 && stdout_fd != 1) close( stdout_fd );
+    return status;
+}
+#else
 /***********************************************************************
  *           spawn_process
  */
@@ -462,6 +550,7 @@
     if (stdout_fd != -1 && stdout_fd != 1) close( stdout_fd );
     return status;
 }
+#endif
 
 
