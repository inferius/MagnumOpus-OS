+use crate::ffi::{OsStr, OsString};
+use crate::os::magnumopus::ffi::{OsStrExt, OsStringExt};
+use crate::path::{self, PathBuf};
+use crate::sys::pal::map_error;
+use crate::{fmt, io, iter, slice};
+
+/// Oddelovac seznamu cest v promennych prostredi (`PATH`).
+const PATH_SEPARATOR: u8 = b':';
+
+pub type SplitPaths<'a> = iter::Map<slice::Split<'a, u8, fn(&u8) -> bool>, fn(&'a [u8]) -> PathBuf>;
+
+fn is_separator(b: &u8) -> bool {
+    *b == PATH_SEPARATOR
+}
+
+pub fn split_paths(unparsed: &OsStr) -> SplitPaths<'_> {
+    fn bytes_to_path(b: &[u8]) -> PathBuf {
+        PathBuf::from(<OsStr as OsStrExt>::from_bytes(b))
+    }
+    unparsed
+        .as_bytes()
+        .split(is_separator as fn(&u8) -> bool)
+        .map(bytes_to_path as fn(&[u8]) -> PathBuf)
+}
+
+pub type SplitPathsRef<'a> =
+    iter::Map<slice::Split<'a, u8, fn(&u8) -> bool>, fn(&'a [u8]) -> &'a path::Path>;
+
+pub fn split_paths_ref(unparsed: &OsStr) -> Option<SplitPathsRef<'_>> {
+    fn bytes_to_path(b: &[u8]) -> &path::Path {
+        path::Path::new(<OsStr as OsStrExt>::from_bytes(b))
+    }
+    Some(
+        unparsed
+            .as_bytes()
+            .split(is_separator as fn(&u8) -> bool)
+            .map(bytes_to_path as fn(&[u8]) -> &path::Path),
+    )
+}
+
+#[derive(Debug)]
+pub struct JoinPathsError;
+
+pub fn join_paths<I, T>(paths: I) -> Result<OsString, JoinPathsError>
+where
+    I: Iterator<Item = T>,
+    T: AsRef<OsStr>,
+{
+    let mut joined = Vec::new();
+    for (i, path) in paths.enumerate() {
+        let path = path.as_ref().as_bytes();
+        if i > 0 {
+            joined.push(PATH_SEPARATOR);
+        }
+        if path.contains(&PATH_SEPARATOR) {
+            return Err(JoinPathsError);
+        }
+        joined.extend_from_slice(path);
+    }
+    Ok(OsString::from_vec(joined))
+}
+
+impl fmt::Display for JoinPathsError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "path segment contains separator `{}`", PATH_SEPARATOR as char)
+    }
+}
+
+impl crate::error::Error for JoinPathsError {}
+
+pub fn getcwd() -> io::Result<PathBuf> {
+    Ok(PathBuf::from(osrt::env::current_dir()))
+}
+
+pub fn chdir(p: &path::Path) -> io::Result<()> {
+    osrt::env::set_current_dir(p.as_os_str().as_bytes()).map_err(map_error)
+}
+
+pub fn home_dir() -> Option<PathBuf> {
+    crate::env::var_os("HOME").map(PathBuf::from)
+}
+
+pub fn current_exe() -> io::Result<PathBuf> {
+    crate::sys::pal::unsupported()
+}
+
+pub fn temp_dir() -> PathBuf {
+    crate::env::var_os("TMPDIR").map(PathBuf::from).unwrap_or_else(|| PathBuf::from("/tmp"))
+}
