+//! MagnumOpus: platforma std. Logika je v crate `osrt` (repozitar
+//! MagnumOpus, `libs/osrt`); tady jen prevody na typy std.
+
+use crate::io;
+
+/// Prevod chyby systemu (`abi::Error`) na `io::Error`; kod chyby je
+/// stabilni zaporny kod MagnumOpus (`raw_os_error`).
+pub(crate) fn map_error(err: osrt::Error) -> io::Error {
+    io::Error::from_raw_os_error(err.code())
+}
+
+// SAFETY: vola se jednou pri startu; runtime uz pripravil `osrt::start`.
+pub unsafe fn init(_argc: isize, _argv: *const *const u8, _sigpipe: u8) {}
+
+// SAFETY: vola se jednou pri ukonceni (nemusi probehnout).
+pub unsafe fn cleanup() {}
+
+pub fn unsupported<T>() -> io::Result<T> {
+    Err(unsupported_err())
+}
+
+pub fn unsupported_err() -> io::Error {
+    io::Error::UNSUPPORTED_PLATFORM
+}
+
+pub fn abort_internal() -> ! {
+    osrt::abort()
+}
