+++ b/std/src/os/magnumopus/rt.rs
@@ -0,0 +1,19 @@
+//! Behove prostredi procesu (osrt) pro knihovny nad std, napr. knihovnu C
+//! `cstd`.
+
+#![stable(feature = "rust1", since = "1.0.0")]
+
+/// Zaregistruje funkci volanou pri ukonceni procesu (`exit`, navrat
+/// z `main`), v obracenem poradi registrace; `false` = prilis mnoho
+/// registraci (C `atexit`).
+#[stable(feature = "rust1", since = "1.0.0")]
+pub fn at_exit(f: extern "C" fn()) -> bool {
+    osrt::at_exit(f)
+}
+
+/// Ukonci proces hned, bez funkci `at_exit` a bez vyprazdneni bufferu
+/// (C `_Exit`).
+#[stable(feature = "rust1", since = "1.0.0")]
+pub fn exit_now(code: i32) -> ! {
+    osrt::exit_now(code)
+}
