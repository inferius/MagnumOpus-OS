diff --git a/std/src/sys/fs/magnumopus.rs b/std/src/sys/fs/magnumopus.rs
new file mode 100644
index 0000000..b5f7f07
--- /dev/null
+++ b/std/src/sys/fs/magnumopus.rs
@@ -0,0 +1,388 @@
+//! Soubory nad relaci FS (`osrt::fs`, fsproto v2).
+
+use crate::ffi::OsString;
+use crate::fmt;
+use crate::fs::TryLockError;
+use crate::hash::{Hash, Hasher};
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut, SeekFrom};
+use crate::os::magnumopus::ffi::{OsStrExt, OsStringExt};
+use crate::path::{Path, PathBuf};
+pub use crate::sys::fs::common::{Dir, ExtraHomeDirs, ExtraMediaDirs};
+use crate::sys::pal::map_error;
+use crate::sys::time::SystemTime;
+use crate::sys::unsupported;
+
+pub struct File(osrt::fs::File);
+
+#[derive(Clone)]
+pub struct FileAttr(osrt::fs::Stat);
+
+pub struct ReadDir {
+    dir: PathBuf,
+    entries: crate::vec::IntoIter<osrt::fs::DirEntry>,
+}
+
+pub struct DirEntry {
+    dir: PathBuf,
+    entry: osrt::fs::DirEntry,
+}
+
+#[derive(Clone, Debug)]
+pub struct OpenOptions(osrt::fs::OpenOptions);
+
+#[derive(Copy, Clone, Debug, Default)]
+pub struct FileTimes {}
+
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub struct FilePermissions {
+    readonly: bool,
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, Hash, Debug)]
+pub struct FileType(u8);
+
+#[derive(Debug)]
+pub struct DirBuilder {}
+
+fn path_bytes(p: &Path) -> &[u8] {
+    p.as_os_str().as_bytes()
+}
+
+impl FileAttr {
+    pub fn size(&self) -> u64 {
+        self.0.size
+    }
+
+    pub fn perm(&self) -> FilePermissions {
+        FilePermissions { readonly: self.0.rights & osrt::fs::rights::WRITE == 0 }
+    }
+
+    pub fn file_type(&self) -> FileType {
+        FileType(self.0.kind)
+    }
+
+    pub fn modified(&self) -> io::Result<SystemTime> {
+        Ok(SystemTime::from_parts(self.0.mtime.secs, self.0.mtime.nanos))
+    }
+
+    pub fn accessed(&self) -> io::Result<SystemTime> {
+        // Cas posledniho cteni se neeviduje (zbytecne zapisy).
+        unsupported()
+    }
+
+    pub fn created(&self) -> io::Result<SystemTime> {
+        Ok(SystemTime::from_parts(self.0.btime.secs, self.0.btime.nanos))
+    }
+}
+
+impl FilePermissions {
+    pub fn readonly(&self) -> bool {
+        self.readonly
+    }
+
+    pub fn set_readonly(&mut self, readonly: bool) {
+        self.readonly = readonly
+    }
+}
+
+impl FileTimes {
+    pub fn set_accessed(&mut self, _t: SystemTime) {}
+    pub fn set_modified(&mut self, _t: SystemTime) {}
+}
+
+impl FileType {
+    pub fn is_dir(&self) -> bool {
+        self.0 == osrt::fs::kind::DIR || self.0 == osrt::fs::kind::DATASET
+    }
+
+    pub fn is_file(&self) -> bool {
+        self.0 == osrt::fs::kind::FILE
+    }
+
+    pub fn is_symlink(&self) -> bool {
+        self.0 == osrt::fs::kind::SYMLINK
+    }
+}
+
+impl ReadDir {
+    pub fn dir(&self) -> io::Result<Dir> {
+        unsupported()
+    }
+}
+
+impl fmt::Debug for ReadDir {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        fmt::Debug::fmt(&self.dir, f)
+    }
+}
+
+impl Iterator for ReadDir {
+    type Item = io::Result<DirEntry>;
+
+    fn next(&mut self) -> Option<io::Result<DirEntry>> {
+        let entry = self.entries.next()?;
+        Some(Ok(DirEntry { dir: self.dir.clone(), entry }))
+    }
+}
+
+impl DirEntry {
+    pub fn path(&self) -> PathBuf {
+        self.dir.join(&self.entry.name)
+    }
+
+    pub fn file_name(&self) -> OsString {
+        OsString::from(self.entry.name.clone())
+    }
+
+    pub fn metadata(&self) -> io::Result<FileAttr> {
+        stat(&self.path())
+    }
+
+    pub fn file_type(&self) -> io::Result<FileType> {
+        Ok(FileType(self.entry.kind))
+    }
+}
+
+impl OpenOptions {
+    pub fn new() -> OpenOptions {
+        OpenOptions(osrt::fs::OpenOptions::default())
+    }
+
+    pub fn read(&mut self, read: bool) {
+        self.0.read = read
+    }
+    pub fn write(&mut self, write: bool) {
+        self.0.write = write
+    }
+    pub fn append(&mut self, append: bool) {
+        self.0.append = append
+    }
+    pub fn truncate(&mut self, truncate: bool) {
+        self.0.truncate = truncate
+    }
+    pub fn create(&mut self, create: bool) {
+        self.0.create = create
+    }
+    pub fn create_new(&mut self, create_new: bool) {
+        self.0.create_new = create_new
+    }
+
+    /// Stejna pravidla jako na unixu (`O_*` kombinace).
+    fn check(&self) -> io::Result<()> {
+        let o = &self.0;
+        let writes = o.write || o.append;
+        if !o.read && !writes {
+            return Err(io::Error::from(io::ErrorKind::InvalidInput));
+        }
+        if !writes && (o.truncate || o.create || o.create_new) {
+            return Err(io::Error::from(io::ErrorKind::InvalidInput));
+        }
+        if o.append && o.truncate && !o.create_new {
+            return Err(io::Error::from(io::ErrorKind::InvalidInput));
+        }
+        Ok(())
+    }
+}
+
+impl File {
+    pub fn open(path: &Path, opts: &OpenOptions) -> io::Result<File> {
+        opts.check()?;
+        osrt::fs::File::open(path_bytes(path), &opts.0).map(File).map_err(map_error)
+    }
+
+    pub fn file_attr(&self) -> io::Result<FileAttr> {
+        self.0.stat().map(FileAttr).map_err(map_error)
+    }
+
+    pub fn fsync(&self) -> io::Result<()> {
+        self.0.sync().map_err(map_error)
+    }
+
+    pub fn datasync(&self) -> io::Result<()> {
+        self.fsync()
+    }
+
+    pub fn lock(&self) -> io::Result<()> {
+        unsupported()
+    }
+
+    pub fn lock_shared(&self) -> io::Result<()> {
+        unsupported()
+    }
+
+    pub fn try_lock(&self) -> Result<(), TryLockError> {
+        Err(TryLockError::Error(unsupported_err()))
+    }
+
+    pub fn try_lock_shared(&self) -> Result<(), TryLockError> {
+        Err(TryLockError::Error(unsupported_err()))
+    }
+
+    pub fn unlock(&self) -> io::Result<()> {
+        unsupported()
+    }
+
+    pub fn truncate(&self, size: u64) -> io::Result<()> {
+        self.0.set_len(size).map_err(map_error)
+    }
+
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        self.0.read(buf).map_err(map_error)
+    }
+
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        crate::io::default_read_vectored(|b| self.read(b), bufs)
+    }
+
+    pub fn is_read_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn read_buf(&self, cursor: BorrowedCursor<'_, u8>) -> io::Result<()> {
+        crate::io::default_read_buf(|b| self.read(b), cursor)
+    }
+
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        self.0.write(buf).map_err(map_error)
+    }
+
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        crate::io::default_write_vectored(|b| self.write(b), bufs)
+    }
+
+    pub fn is_write_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn flush(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn seek(&self, pos: SeekFrom) -> io::Result<u64> {
+        let pos = match pos {
+            SeekFrom::Start(p) => osrt::fs::SeekFrom::Start(p),
+            SeekFrom::End(d) => osrt::fs::SeekFrom::End(d),
+            SeekFrom::Current(d) => osrt::fs::SeekFrom::Current(d),
+        };
+        self.0.seek(pos).map_err(map_error)
+    }
+
+    pub fn size(&self) -> Option<io::Result<u64>> {
+        Some(self.file_attr().map(|a| a.size()))
+    }
+
+    pub fn tell(&self) -> io::Result<u64> {
+        Ok(self.0.tell())
+    }
+
+    pub fn duplicate(&self) -> io::Result<File> {
+        unsupported()
+    }
+
+    pub fn set_permissions(&self, _perm: FilePermissions) -> io::Result<()> {
+        unsupported()
+    }
+
+    pub fn set_times(&self, _times: FileTimes) -> io::Result<()> {
+        unsupported()
+    }
+}
+
+fn unsupported_err() -> io::Error {
+    crate::sys::pal::unsupported_err()
+}
+
+impl DirBuilder {
+    pub fn new() -> DirBuilder {
+        DirBuilder {}
+    }
+
+    pub fn mkdir(&self, p: &Path) -> io::Result<()> {
+        osrt::fs::create_dir(path_bytes(p)).map_err(map_error)
+    }
+}
+
+impl fmt::Debug for File {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("File").finish_non_exhaustive()
+    }
+}
+
+impl fmt::Debug for FileAttr {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("FileAttr").field("size", &self.0.size).field("kind", &self.0.kind).finish()
+    }
+}
+
+impl Hash for FilePermissions {
+    fn hash<H: Hasher>(&self, h: &mut H) {
+        self.readonly.hash(h)
+    }
+}
