@@ -0,0 +1,360 @@
+//! Procesy pres spousteci sluzbu launchd (`osrt::process`).
+
+use super::CommandEnvs;
+use super::env::{CommandEnv, CommandResolvedEnvs};
+use crate::ffi::{OsStr, OsString};
+pub use crate::ffi::OsString as EnvKey;
+use crate::num::NonZeroI32;
+use crate::os::magnumopus::ffi::{OsStrExt, OsStringExt};
+use crate::path::Path;
+use crate::process::StdioPipes;
+use crate::sys::fs::File;
+use crate::sys::pal::map_error;
+use crate::{fmt, io};
+
+pub enum Stdio {
+    Inherit,
+    Null,
+    MakePipe,
+    ParentStdout,
+    ParentStderr,
+    /// Konec roury (`io::pipe`, `ChildStdout` jako vstup jineho potomka).
+    Pipe(crate::sys::pipe::Pipe),
+    /// Soubor jako stdio zatim nejde (proud je kanal, ne soubor).
+    File,
+}
+
+impl Stdio {
+    fn into_spec(self) -> io::Result<osrt::process::StdioSpec> {
+        use osrt::process::StdioSpec as S;
+        Ok(match self {
+            Stdio::Inherit | Stdio::ParentStdout | Stdio::ParentStderr => S::Inherit,
+            Stdio::Null => S::Null,
+            Stdio::MakePipe => S::Pipe,
+            Stdio::Pipe(p) => S::Channel(p.0.into_channel()),
+            Stdio::File => {
+                return Err(io::const_error!(io::ErrorKind::Unsupported, "soubor jako stdio potomka zatim nejde"));
+            }
+        })
+    }
+
+    /// Kopie pro dalsi spusteni stejneho `Command` (roura se predava jen
+    /// jednou: konec roury by jinak sdilely dva procesy).
+    fn duplicate(&self) -> io::Result<Stdio> {
+        Ok(match self {
+            Stdio::Inherit => Stdio::Inherit,
+            Stdio::Null => Stdio::Null,
+            Stdio::MakePipe => Stdio::MakePipe,
+            Stdio::ParentStdout => Stdio::ParentStdout,
+            Stdio::ParentStderr => Stdio::ParentStderr,
+            Stdio::Pipe(p) => Stdio::Pipe(p.try_clone()?),
+            Stdio::File => Stdio::File,
+        })
+    }
+}
+
+#[derive(Default)]
+pub struct Command {
+    program: OsString,
+    args: Vec<OsString>,
+    cwd: Option<OsString>,
+    stdin: Option<Stdio>,
+    stdout: Option<Stdio>,
+    stderr: Option<Stdio>,
+    env: CommandEnv,
+    network: bool,
+}
+
+impl Command {
+    pub fn new(program: &OsStr) -> Command {
+        Command { program: program.to_owned(), ..Default::default() }
+    }
+
+    pub fn arg(&mut self, arg: &OsStr) {
+        self.args.push(arg.to_owned())
+    }
+
+    pub fn env_mut(&mut self) -> &mut CommandEnv {
+        &mut self.env
+    }
+
+    pub fn cwd(&mut self, dir: &OsStr) {
+        self.cwd = Some(dir.to_owned())
+    }
+
+    pub fn stdin(&mut self, stdin: Stdio) {
+        self.stdin = Some(stdin);
+    }
+
+    pub fn stdout(&mut self, stdout: Stdio) {
+        self.stdout = Some(stdout);
+    }
+
+    pub fn stderr(&mut self, stderr: Stdio) {
+        self.stderr = Some(stderr);
+    }
+
+    /// `CommandExt::network`: predat potomkovi relaci site.
+    pub fn set_network(&mut self, on: bool) {
+        self.network = on;
+    }
+
+    pub fn get_program(&self) -> &OsStr {
+        &self.program
+    }
+
+    pub fn get_args(&self) -> CommandArgs<'_> {
+        CommandArgs { iter: self.args.iter() }
+    }
+
+    pub fn get_envs(&self) -> CommandEnvs<'_> {
+        self.env.iter()
+    }
+
+    pub fn get_env_clear(&self) -> bool {
+        self.env.does_clear()
+    }
+
+    pub fn get_resolved_envs(&self) -> CommandResolvedEnvs {
+        CommandResolvedEnvs::new(self.env.capture())
+    }
+
+    pub fn get_current_dir(&self) -> Option<&Path> {
+        self.cwd.as_ref().map(Path::new)
+    }
+
+    pub fn spawn(&mut self, default: Stdio, needs_stdin: bool) -> io::Result<(Process, StdioPipes)> {
+        let pick = |s: &Option<Stdio>, fallback: &Stdio| -> io::Result<Stdio> {
+            match s {
+                Some(s) => s.duplicate(),
+                None => fallback.duplicate(),
+            }
+        };
+        let stdin = if self.stdin.is_some() || needs_stdin { pick(&self.stdin, &default)? } else { Stdio::Null };
+        let stdout = pick(&self.stdout, &default)?;
+        let stderr = pick(&self.stderr, &default)?;
+
+        let program = self.program.to_str().ok_or_else(|| {
+            io::const_error!(io::ErrorKind::InvalidInput, "jmeno programu neni UTF-8")
+        })?;
+        let mut args = vec![self.program.as_bytes().to_vec()];
+        args.extend(self.args.iter().map(|a| a.as_bytes().to_vec()));
+        let env = self
+            .env
+            .capture()
+            .into_iter()
+            .map(|(k, v)| {
+                let mut e = k.into_vec();
+                e.push(b'=');
+                e.extend_from_slice(v.as_bytes());
+                e
+            })
+            .collect();
+        let cwd = match &self.cwd {
+            // Relativni adresar potomka je vuci adresari rodice.
+            Some(d) => osrt::env::resolve(d.as_bytes()).map_err(map_error)?.into_bytes(),
+            None => osrt::env::current_dir().into_bytes(),
+        };
+        let spawn = osrt::process::Spawn {
+            program: program.into(),
+            args,
+            env,
+            cwd,
+            stdin: stdin.into_spec()?,
+            stdout: stdout.into_spec()?,
+            stderr: stderr.into_spec()?,
+            network: self.network,
+        };
+        let (child, pipes) = osrt::process::spawn(spawn).map_err(launch_error)?;
+        let wrap = |p: Option<osrt::pipe::Pipe>| p.map(crate::sys::pipe::Pipe);
+        Ok((
+            Process { child },
+            StdioPipes { stdin: wrap(pipes.stdin), stdout: wrap(pipes.stdout), stderr: wrap(pipes.stderr) },
+        ))
+    }
+}
+
+/// Chyba spusteni s popisem od launchd (napr. ktery svazek pripojit).
+fn launch_error((e, msg): (osrt::Error, String)) -> io::Error {
+    if msg.is_empty() {
+        return map_error(e);
+    }
+    let kind = crate::sys::io::decode_error_kind(e.code());
+    io::Error::new(kind, format!("{msg} ({})", e.name()))
+}
+
+pub fn output(cmd: &mut Command) -> io::Result<(ExitStatus, Vec<u8>, Vec<u8>)> {
+    let (mut process, mut pipes) = cmd.spawn(Stdio::MakePipe, false)?;
+    drop(pipes.stdin.take());
+    let (mut stdout, mut stderr) = (Vec::new(), Vec::new());
+    let read_result = match (pipes.stdout.take(), pipes.stderr.take()) {
+        (None, None) => Ok(()),
+        (Some(out), None) => out.read_to_end(&mut stdout).map(|_| ()),
+        (None, Some(err)) => err.read_to_end(&mut stderr).map(|_| ()),
+        (Some(out), Some(err)) => read_output(out, &mut stdout, err, &mut stderr),
+    };
+    let status = process.wait();
+    read_result?;
+    Ok((status?, stdout, stderr))
+}
+
+impl From<crate::sys::pipe::Pipe> for Stdio {
+    fn from(pipe: crate::sys::pipe::Pipe) -> Stdio {
+        Stdio::Pipe(pipe)
+    }
+}
