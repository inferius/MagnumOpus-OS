+pub use super::common::Env;
+use crate::ffi::{OsStr, OsString};
+use crate::io;
+use crate::os::magnumopus::ffi::{OsStrExt, OsStringExt};
+use crate::sys::pal::map_error;
+
+pub fn env() -> Env {
+    Env::new(
+        osrt::env::vars()
+            .into_iter()
+            .map(|(k, v)| (OsString::from_vec(k), OsString::from_vec(v)))
+            .collect(),
+    )
+}
+
+pub fn getenv(key: &OsStr) -> Option<OsString> {
+    osrt::env::var(key.as_bytes()).map(OsString::from_vec)
+}
+
+pub unsafe fn setenv(key: &OsStr, val: &OsStr) -> io::Result<()> {
+    osrt::env::set_var(key.as_bytes(), val.as_bytes()).map_err(map_error)
+}
+
+pub unsafe fn unsetenv(key: &OsStr) -> io::Result<()> {
+    osrt::env::remove_var(key.as_bytes());
+    Ok(())
+}
