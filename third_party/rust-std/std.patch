+    /// Stejna pravidla jako na unixu (`O_*` kombinace).
+    fn check(&self) -> io::Result<()> {
+        let o = &self.0;
+        let writes = o.write || o.append;
+        if !o.read && !writes {
+            return Err(io::Error::from(io::ErrorKind::InvalidInput));
+        }
+        if !writes && (o.truncate || o.create || o.create_new) {
+            return Err(io::Error::from(io::ErrorKind::InvalidInput));
+        }
+        if o.append && o.truncate && !o.create_new {
+            return Err(io::Error::from(io::ErrorKind::InvalidInput));
+        }
+        Ok(())
+    }
+}
