+//! Rozsireni std pro MagnumOpus.
+
+#![stable(feature = "rust1", since = "1.0.0")]
+#![deny(unsafe_op_in_unsafe_fn)]
+
+pub mod ffi;
+pub mod fs;
+pub mod process;
+pub mod rt;
+
+/// Behove prostredi procesu (crate `osrt`): interni rozhrani pro knihovny
+/// nad std ve stejnem procesu, hlavne knihovnu C `cstd` (tabulka fd,
+/// vlakna, cas). Aplikace ho nepouzivaji; API se muze menit.
+#[unstable(feature = "magnumopus_runtime", issue = "none")]
+pub use osrt as runtime;
+
+/// Rozsirujici traity (`use std::os::magnumopus::prelude::*`).
+#[stable(feature = "rust1", since = "1.0.0")]
+pub mod prelude {
+    #[doc(no_inline)]
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub use super::ffi::{OsStrExt, OsStringExt};
+}
diff --git a/std/src/os/magnumopus/process.rs b/std/src/os/magnumopus/process.rs
new file mode 100644
index 0000000..bdd315a
--- /dev/null
+++ b/std/src/os/magnumopus/process.rs
@@ -0,0 +1,31 @@
+//! Rozsireni `std::process` pro MagnumOpus.
+
+#![stable(feature = "rust1", since = "1.0.0")]
+
+use crate::process;
+use crate::sys::AsInnerMut;
+
+/// Rozsireni [`process::Command`].
+#[stable(feature = "rust1", since = "1.0.0")]
+pub trait CommandExt: Sealed {
+    /// Preda potomkovi relaci site procesu (vychozi: potomek sit nema).
+    /// Program s manifestem dostane jen prunik se svym manifestem
+    /// (launchd relaci zuzi); bez `[network]` v manifestu nic.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn network(&mut self, on: bool) -> &mut process::Command;
+}
+
+#[stable(feature = "rust1", since = "1.0.0")]
+impl CommandExt for process::Command {
+    fn network(&mut self, on: bool) -> &mut process::Command {
+        self.as_inner_mut().set_network(on);
+        self
+    }
+}
+
+/// Traity jen pro typy std.
+#[stable(feature = "rust1", since = "1.0.0")]
+pub trait Sealed {}
+
+#[stable(feature = "rust1", since = "1.0.0")]
+impl Sealed for process::Command {}
