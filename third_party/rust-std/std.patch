+use crate::ffi::CStr;
+use crate::io;
+use crate::num::NonZeroUsize;
+use crate::sys::pal::map_error;
+use crate::thread::ThreadInit;
+use crate::time::{Duration, Instant};
+
+pub const DEFAULT_MIN_STACK_SIZE: usize = 2 * 1024 * 1024;
+
+pub struct Thread {
+    inner: osrt::thread::Thread,
+}
+
+unsafe impl Send for Thread {}
+unsafe impl Sync for Thread {}
+
+impl Thread {
+    pub unsafe fn new(stack: usize, init: Box<ThreadInit>) -> io::Result<Thread> {
+        let inner = osrt::thread::spawn(
+            stack,
+            Box::new(move || {
+                let rust_start = init.init();
+                rust_start();
+                // std je jediny runtime: destruktory TLS spousti samo.
+                // SAFETY: vlakno konci, TLS uz nic dalsiho nepouzije.
+                unsafe { crate::sys::thread_local::destructors::run() };
+                crate::rt::thread_cleanup();
+            }),
+        )
+        .map_err(map_error)?;
+        Ok(Thread { inner })
+    }
+
+    pub fn join(self) {
+        // std ocekava, ze join neselze; chyba = vlakno uz neexistuje.
+        let _ = self.inner.join();
+    }
+}
+
+pub fn set_name(_name: &CStr) {
+    // Jmeno vlakna se v jadre zadava pri vytvoreni; std si ho drzi samo.
+}
+
+pub fn current_os_id() -> Option<u64> {
+    None
+}
+
+pub fn available_parallelism() -> io::Result<NonZeroUsize> {
+    osrt::thread::cpu_count()
+        .and_then(NonZeroUsize::new)
+        .ok_or_else(|| io::const_error!(io::ErrorKind::NotFound, "pocet CPU neni znamy"))
+}
+
+pub fn yield_now() {
+    osrt::thread::yield_now()
+}
+
+pub fn sleep(dur: Duration) {
+    osrt::thread::sleep(dur)
+}
+
+pub fn sleep_until(deadline: Instant) {
+    osrt::thread::sleep_until(deadline.into_inner().as_nanos_since_boot())
+}
