+++ b/std/src/sys/alloc/magnumopus.rs
@@ -0,0 +1,25 @@
+use crate::alloc::Layout;
+
+#[inline]
+pub unsafe fn alloc(layout: Layout) -> *mut u8 {
+    // SAFETY: predano volajicim (platny layout s nenulovou velikosti).
+    unsafe { osrt::heap::alloc(layout.size(), layout.align()) }
+}
+
+#[inline]
+pub unsafe fn alloc_zeroed(layout: Layout) -> *mut u8 {
+    // SAFETY: viz `alloc`.
+    unsafe { osrt::heap::alloc_zeroed(layout.size(), layout.align()) }
+}
+
+#[inline]
+pub unsafe fn dealloc(ptr: *mut u8, layout: Layout) {
+    // SAFETY: `ptr` je z tohoto alokatoru se stejnym layoutem.
+    unsafe { osrt::heap::dealloc(ptr, layout.size(), layout.align()) }
+}
+
+#[inline]
+pub unsafe fn realloc(ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+    // SAFETY: viz `dealloc`.
+    unsafe { osrt::heap::realloc(ptr, layout.size(), layout.align(), new_size) }
+}
