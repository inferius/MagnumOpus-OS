@@ -0,0 +1,56 @@
+use crate::{fmt, io};
+
+/// MagnumOpus nema `errno`: chyby vraci kazde volani primo.
+pub fn errno() -> io::RawOsError {
+    osrt::Error::BadState.code()
+}
+
+pub fn is_interrupted(_code: io::RawOsError) -> bool {
+    // Bez signalu: volani se nikdy neprerusi.
+    false
+}
+
+pub fn decode_error_kind(code: io::RawOsError) -> io::ErrorKind {
+    use io::ErrorKind as K;
+    use osrt::Error as E;
+    let Some(e) = E::from_code(i64::from(code)) else {
+        return K::Uncategorized;
+    };
+    match e {
+        E::BadHandle | E::WrongType | E::InvalidArgs | E::BadAddress | E::OutOfRange => K::InvalidInput,
+        E::AccessDenied => K::PermissionDenied,
+        E::TimedOut => K::TimedOut,
+        E::NoMemory => K::OutOfMemory,
+        E::NotFound => K::NotFound,
+        E::NotSupported | E::BadSyscall => K::Unsupported,
+        E::Corrupted => K::InvalidData,
+        E::ShouldWait | E::Locked => K::WouldBlock,
+        E::PeerClosed => K::BrokenPipe,
+        E::AlreadyExists => K::AlreadyExists,
+        E::NotADirectory => K::NotADirectory,
+        E::IsADirectory => K::IsADirectory,
+        E::NotEmpty => K::DirectoryNotEmpty,
+        E::NoSpace => K::StorageFull,
+        E::ReadOnly => K::ReadOnlyFilesystem,
+        E::ConnectionRefused => K::ConnectionRefused,
+        E::ConnectionReset => K::ConnectionReset,
+        E::Unreachable => K::HostUnreachable,
+        E::AddressInUse => K::AddrInUse,
+        E::Canceled => K::Interrupted,
+        E::NoResources => K::QuotaExceeded,
+        E::BufferTooSmall
+        | E::BadState
+        | E::IoError
+        | E::Conflict
+        | E::JournalGap
+        | E::ServiceRestarted
+        | E::ServiceUnavailable => K::Other,
+    }
+}
+
+pub fn format_error(errno: io::RawOsError, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+    match osrt::Error::from_code(i64::from(errno)) {
+        Some(e) => f.write_str(e.name()),
+        None => write!(f, "neznama chyba {errno}"),
+    }
+}
